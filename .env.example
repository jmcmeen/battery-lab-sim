# ---------------------------------------------------------------------------
# Local-dev defaults. Every secret below is a placeholder for `docker compose
# up` on a developer laptop. **Rotate every credential before any deployment
# beyond a single laptop** — including a shared lab machine. See SECURITY.md.
# ---------------------------------------------------------------------------

# Cycler / channel configuration
CHANNELS_PER_CYCLER=32
NUM_CYCLERS=16                      # full bench: 16 chassis × 32 = 512 channels
SIM_TIME_FACTOR=50                  # 1 wall-second = N simulated seconds (50 makes the smoke test ≈1min)
TELEMETRY_HZ=10

# Thermal chambers
CHAMBER_A_SETPOINT_C=25.0           # cyclers 01–08
CHAMBER_B_SETPOINT_C=45.0           # cyclers 09–16
CHAMBER_TAU_S=600.0

# Per-cycler chemistry. The `CHEMISTRY` env in docker-compose.yml is the
# cycler's BOOT-TIME chemistry only — the orchestrator writes the chassis
# CHEMISTRY Modbus register at every experiment kickoff using
# `schedule.chemistry`, and the cycler rebuilds its 32 ECMCell instances
# to match. So you almost never need to touch these overrides; they only
# matter for tests / soaks that bring up the cycler without an
# orchestrator-driven kickoff (e.g. `make demo` with no schedule, or
# chaos scripts that read cells before a schedule lands).
#
# Boot-time defaults baked into docker-compose.yml:
#   - Chamber A (25 °C) → cyclers 01-08 boot LCO
#   - Chamber B (45 °C) → cyclers 09-16 boot NMC
# Override individual cyclers with CYCLER_NN_CHEMISTRY=NMC|LCO|NMC+SiC|LCO+SiC
# (NN = two-digit chassis id, 01-16). Examples:
# CYCLER_01_CHEMISTRY=NMC+SiC        # boot cycler_01 with silicon-carbon NMC
# CYCLER_09_CHEMISTRY=LCO+SiC        # boot cycler_09 with silicon-carbon LCO at 45 °C

# Postgres (metadata)
POSTGRES_USER=lab
POSTGRES_PASSWORD=changeme
POSTGRES_DB=lab

# TimescaleDB (telemetry hot tier)
TSDB_USER=lab
TSDB_PASSWORD=changeme
TSDB_DB=telemetry

# MQTT
MQTT_HOST=mosquitto
MQTT_PORT=1883

# MinIO (cold tier)
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=changeme

# parquet_export
PARQUET_BUCKET=lab-archive
PARQUET_EXPORT_AGE_HOURS=24         # only export chunks older than this
PARQUET_EXPORT_PERIOD_S=3600        # export run cadence (wall seconds)

# Analytics — dQ/dV feature engineering + R0 anomaly detection
ANALYTICS_DQDV_BIN_MV=10            # voltage bin width for Severson-style dQ/dV (10 mV for NMC)
ANALYTICS_DQDV_PEAK_HEIGHT=0.1      # minimum |dQ/dV| to count as a peak
ANALYTICS_R0_JUMP_THRESHOLD_PCT=20.0  # cycle-over-cycle R0 jump that fires a warning alert

# Watchdog tunables (v0.1.8). Every monitor's threshold is operator-tunable
# via env; defaults match the historical hardcoded constants so chaos recipes
# and integration tests still pass unchanged.
#
# Heartbeat monitor — orchestrator liveness.
# HARD CONTRAINT: keep WATCHDOG_HEARTBEAT_THRESHOLD_S at 10. The chaos recipes
# (CLAUDE.md "Add a new chaos scenario" #3) treat 10 s wall as the canonical
# heartbeat-stale floor; lowering it would break those tests.
WATCHDOG_HEARTBEAT_THRESHOLD_S=10   # wall-s without a heartbeat → critical alert
WATCHDOG_HEARTBEAT_POLL_S=2         # how often we check (wall seconds)

# Chamber drift monitor — sustained deviation outside the band.
WATCHDOG_CHAMBER_BREACH_BAND_C=5.0  # °C: |measured − setpoint| beyond this starts the breach timer
WATCHDOG_CHAMBER_BREACH_DURATION_S=300  # wall-s the breach must persist to alert
WATCHDOG_CHAMBER_STARTUP_GRACE_S=60     # wall-s soak-in window — suppresses cold-boot transients
WATCHDOG_CHAMBER_CHECK_PERIOD_S=5       # wall-s sweep cadence

# Chassis dead-man monitor. Sim-time poll (scales with SIM_TIME_FACTOR).
WATCHDOG_CHASSIS_POLL_SIM_S=5.0     # sim-s between status reads
WATCHDOG_CHASSIS_STARTUP_GRACE_POLLS=1  # suppress first N polls' edges (cycler can briefly read 1 at boot)

# Fleet-failure monitor — single critical alert when many experiments
# transition to failed inside a rolling wall-time window. Tuned so a healthy
# bench never trips, but a v0.1.7-style FD-leak fleet trip surfaces as one
# rolled-up alert instead of 507 leaf alerts.
WATCHDOG_FLEET_FAIL_THRESHOLD=8     # ≥N failures inside the window → critical alert
WATCHDOG_FLEET_FAIL_WINDOW_S=30     # rolling window length (wall seconds)
WATCHDOG_FLEET_FAIL_POLL_S=10       # how often the monitor scans the window

# Soak runs (make soak.start) — chassis range and channels-per-chassis live
# in each schedule's `bench:` block (see schedules/soak_25c_lco.yaml).
# Pick a non-default schedule with `SCHEDULE=soak_45c_nmc make soak.start`.

# Grafana
GRAFANA_ADMIN_PASSWORD=changeme

# Container log rotation (applies to every service via the x-logging anchor
# in docker-compose.yml). Default Docker has no rotation, so structlog JSON
# at ~5,120 rows/s fills the host disk overnight. Per-container ceiling is
# LOG_MAX_SIZE × LOG_MAX_FILE; 50m × 5 × ~33 containers ≈ 8.25 GB total.
LOG_MAX_SIZE=50m
LOG_MAX_FILE=5
